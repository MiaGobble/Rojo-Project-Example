local Symbol = {}

-- Types
export type Symbol = typeof(newproxy(true))

function Symbol.new(Name : string)
    local self = newproxy(true)

    getmetatable(self).__tostring = function()
        return Name
    end

    return self
end

return Symbol]]></ProtectedString>
