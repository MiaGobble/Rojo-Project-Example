											<bool name="DefinesCapabilities">false</bool>
											<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
											<string name="Name">OnAttached</string>
											<int64 name="SourceAssetId">-1</int64>
											<BinaryString name="Tags"></BinaryString>
											<UniqueId name="UniqueId">4905704009d6308b0a37354f00001566</UniqueId>
										</Properties>
									</Item>
									<Item class="ModuleScript" referent="RBXA78C4F18AEEB4FD499F912858BEE2053">
